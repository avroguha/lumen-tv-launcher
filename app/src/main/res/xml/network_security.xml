<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything is HTTPS except ip-api.com, whose free tier is plain HTTP (used only to find the city). -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
