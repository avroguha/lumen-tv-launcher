<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lumen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <!-- the trailer screen: opaque to the window manager (nothing behind it is drawn), clear pixels where the TV's video plane shows -->
    <style name="Theme.Lumen.Trailer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
